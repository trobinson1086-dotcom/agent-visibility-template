{
	// Route Worker that serves /assets/media/* from R2 with byte ranges.
	// Deploy: npx wrangler deploy -c wrangler.media.jsonc
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "squishman-media",
	"main": "./src/media-worker/index.ts",
	"compatibility_date": "2025-10-08",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "squishman.com/assets/media/*",
			"zone_name": "squishman.com"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "squishman-media"
		}
	]
}
