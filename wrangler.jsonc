{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "squishman",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-10-08",
	"upload_source_maps": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist/client",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/.well-known/web-bot-auth/*",
			"/api",
			"/api/*",
			"/index.json",
			"/jsonld",
			"/llms-full.txt",
			"/llms.txt",
			"/robots.txt",
			"/*.jsonld",
			"/*.md"
		]
	},
	"triggers": {
		// Hourly cache rebuild (see rebuildCache in src/lib/store.ts).
		"crons": ["17 * * * *"]
	},
	"ai": {
		"binding": "AI"
	},
	"d1_databases": [
		{
			// Fulfillment order records (src/fulfillment/store.ts, migrations/).
			"binding": "ORDERS_DB",
			"database_name": "squishman-orders",
			"database_id": "2a5ded37-5432-4af6-964c-6943a41f2d49",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "VISIBILITY_CACHE",
			"id": "c16823d6f6f6460ea52d08c2dbbfaaca"
		}
	],
	"vars": {
		"SITE_NAME": "Squish Man™",
		"SITE_DESCRIPTION": "The Amazing Adventures of Squish Man™ — picture books, learning & activity books, Spanish editions and coloring books for K–4 readers (ages 5–9), set in Maple Hollow.",
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"ENRICHMENT_CACHE_TTL": "3600",
		"CONTENT_SIGNAL": "ai-input=yes, search=yes, ai-train=no",
		"ENABLE_WEB_BOT_AUTH": "false",
		// Lulu fulfillment: "off" | "sandbox" | "production". Off until Book 1 passes testing.
		"FULFILLMENT_MODE": "off",
		"LULU_SHIPPING_LEVEL": "GROUND",
		"FULFILLMENT_CONTACT_EMAIL": "orders@squishman.com"
	}
}
